{
  "name": "booking-pro",
  "version": "1.0.0",
  "private": true,
  "description": "Système de réservation en ligne complet pour artisans et prestataires de services",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"pnpm --filter backend dev\" \"pnpm --filter frontend dev\"",
    "build": "pnpm --filter shared build && pnpm --filter prisma generate && pnpm --filter backend build && pnpm --filter frontend build",
    "db:migrate": "pnpm --filter prisma migrate dev",
    "db:seed": "pnpm --filter prisma seed",
    "db:studio": "pnpm --filter prisma studio",
    "lint": "pnpm -r lint",
    "type-check": "pnpm -r type-check"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@parcel/watcher",
      "@prisma/client",
      "@prisma/engines",
      "bcrypt",
      "esbuild",
      "prisma",
      "vue-demi"
    ]
  }
}
