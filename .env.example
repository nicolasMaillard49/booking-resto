# ============================================
# BOOKING PRO — Variables d'environnement
# ============================================
# Copier ce fichier en .env et remplir les valeurs

# --- DATABASE ---
DATABASE_URL="postgresql://booking:booking123@localhost:5432/booking_pro"

# --- JWT ---
JWT_SECRET="change-me-in-production-use-a-long-random-string"
JWT_REFRESH_SECRET="change-me-refresh-secret-also-very-long"
JWT_EXPIRES_IN="1h"
JWT_REFRESH_EXPIRES_IN="7d"

# --- SERVEUR ---
PORT=3001
NODE_ENV="development"

# --- CORS ---
FRONTEND_URL="http://localhost:3000"

# --- EMAIL (Nodemailer) ---
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="noreply@example.com"
SMTP_PASS="your-smtp-password"
EMAIL_FROM="Booking Pro <noreply@example.com>"

# --- STRIPE (optionnel) ---
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# --- FRONTEND (Nuxt) ---
NUXT_PUBLIC_API_URL="http://localhost:3001"
NUXT_PUBLIC_SITE_URL="http://localhost:3000"
