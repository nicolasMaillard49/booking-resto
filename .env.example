# ============================================
# BOOKING-RESTO — Variables d'environnement
# ============================================
# Copier ce fichier en apps/backend/.env et remplir les valeurs

# --- DATABASE ---
DATABASE_URL="postgresql://booking:booking123@localhost:5440/booking_resto"

# --- JWT ---
JWT_SECRET="change-me-in-production-use-a-long-random-string"
JWT_REFRESH_SECRET="change-me-refresh-secret-also-very-long"
JWT_EXPIRES_IN="1h"
JWT_REFRESH_EXPIRES_IN="7d"

# --- SERVEUR ---
PORT=3101
NODE_ENV="development"
TZ="Europe/Paris"

# --- CORS ---
FRONTEND_URL="http://localhost:3100"

# --- EMAIL — DEV (MailHog) ---
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""

# --- EMAIL — PROD (Resend) ---
RESEND_API_KEY=""
MAIL_FROM="Mon Restaurant <reservation@example.fr>"
ADMIN_EMAIL="admin@example.fr"

# --- FRONTEND (Nuxt) ---
NUXT_PUBLIC_API_URL="http://localhost:3101"
NUXT_PUBLIC_SITE_URL="http://localhost:3100"
